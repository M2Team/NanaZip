<Page
  x:Class="NanaZip.Modern.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock
      x:Uid="/NanaZip.Modern/SettingsPage/TitleTextBlock"
      Margin="16,0"
      HorizontalAlignment="Center"
      FontSize="24"
      FontWeight="SemiBold"
      Text="[Settings]" />

    <ScrollViewer Grid.Row="1" Padding="16,8">
      <StackPanel Spacing="24">
        <!-- Theme Section -->
        <StackPanel Spacing="12">
          <TextBlock
            x:Uid="/NanaZip.Modern/SettingsPage/ThemeSectionTitle"
            FontSize="16"
            FontWeight="SemiBold"
            Text="[Appearance]" />

          <StackPanel Spacing="8">
            <TextBlock
              x:Uid="/NanaZip.Modern/SettingsPage/ThemeLabel"
              FontSize="14"
              Text="[Theme]" />

            <ComboBox
              x:Name="ThemeComboBox"
              HorizontalAlignment="Stretch"
              SelectionChanged="ThemeComboBox_SelectionChanged">
              <ComboBoxItem x:Name="TransparentThemeItem" Tag="0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <SymbolIcon Symbol="Transparent" />
                  <TextBlock
                    x:Uid="/NanaZip.Modern/SettingsPage/TransparentTheme"
                    VerticalAlignment="Center"
                    Text="[Transparent]" />
                </StackPanel>
              </ComboBoxItem>
              <ComboBoxItem x:Name="GlassyThemeItem" Tag="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <SymbolIcon Symbol="Blur" />
                  <TextBlock
                    x:Uid="/NanaZip.Modern/SettingsPage/GlassyTheme"
                    VerticalAlignment="Center"
                    Text="[Glassy / Blurry]" />
                </StackPanel>
              </ComboBoxItem>
              <ComboBoxItem x:Name="MatteThemeItem" Tag="2">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <SymbolIcon Symbol="Solid" />
                  <TextBlock
                    x:Uid="/NanaZip.Modern/SettingsPage/MatteTheme"
                    VerticalAlignment="Center"
                    Text="[Matte / Acrylic]" />
                </StackPanel>
              </ComboBoxItem>
            </ComboBox>
          </StackPanel>
        </StackPanel>

        <!-- About Section -->
        <StackPanel Spacing="12">
          <TextBlock
            x:Uid="/NanaZip.Modern/SettingsPage/AboutSectionTitle"
            FontSize="16"
            FontWeight="SemiBold"
            Text="[About]" />

          <StackPanel Spacing="8">
            <TextBlock
              x:Uid="/NanaZip.Modern/SettingsPage/VersionLabel"
              FontSize="14"
              Text="[Version]" />
            <TextBlock x:Name="VersionTextBlock" FontSize="14" Opacity="0.8" />
          </StackPanel>

          <Button
            x:Uid="/NanaZip.Modern/SettingsPage/GitHubButton"
            HorizontalAlignment="Stretch"
            Click="GitHubButtonClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <SymbolIcon Symbol="Link" />
              <TextBlock VerticalAlignment="Center" Text="[GitHub Repository]" />
            </StackPanel>
          </Button>

          <Button
            x:Uid="/NanaZip.Modern/SettingsPage/LicenseButton"
            HorizontalAlignment="Stretch"
            Click="LicenseButtonClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <SymbolIcon Symbol="Document" />
              <TextBlock VerticalAlignment="Center" Text="[License]" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>