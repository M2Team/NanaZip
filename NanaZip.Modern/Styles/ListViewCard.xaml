<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///NanaZip.Modern/Styles/SettingsCard.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="ListViewCardWithExpanderStyle" TargetType="ListView">
    <Setter Property="Background" Value="{ThemeResource SettingsCardBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource SettingsCardBorderThickness}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="IsTabStop" Value="False" />

    <!-- HeaderTemplate in ItemsPresenter only support pure text.
         If want use control as header's content like Expander, please use ExpanderHeader.
    <Setter Property="HeaderTemplate">
      <Setter.Value>
        <DataTemplate>
          <ContentPresenter
            Content="{Binding}"
            Padding="{StaticResource SettingsCardPadding}"
            BorderBrush="{ThemeResource SettingsCardBorderBrush}"
            BorderThickness="0,0,0,0" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    -->

    <!-- FooterTemplate in ItemsPresenter only support pure text.
         If want use control as footer's content like Button, please use ExpanderFooter.
    <Setter Property="FooterTemplate">
      <Setter.Value>
        <DataTemplate>
          <ContentPresenter
            Content="{Binding}"
            Padding="{StaticResource SettingsExpanderItemPadding}"
            BorderBrush="{ThemeResource SettingsCardBorderBrush}"
            BorderThickness="{StaticResource SettingsExpanderItemBorderThickness}"
            MinHeight="{StaticResource SettingsExpanderItemMinHeight}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    -->

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListView">
          <StackPanel
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ExpandStates">
                <VisualState x:Name="ExpandUp">
                  <VisualState.StateTriggers>
                    <StateTrigger IsActive="{Binding IsChecked, ElementName=ExpanderHeaderToggle}" />
                  </VisualState.StateTriggers>
                  <VisualState.Setters>
                    <Setter Target="ScrollViewer.Visibility" Value="Visible" />
                    <Setter Target="ExpanderFooter.Visibility" Value="Visible" />
                    <Setter Target="ExpandCollapseChevron.Glyph" Value="{StaticResource ExpanderChevronUpGlyph}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <!--
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Disabled">
                  <VisualState.StateTriggers>
                    <StateTrigger IsActive="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter=}" />
                  </VisualState.StateTriggers>
                  <VisualState.Setters />
                </VisualState>
              </VisualStateGroup>
              -->
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="ExpanderHeader">
              <ToggleButton x:Name="ExpanderHeaderToggle"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                MinHeight="{StaticResource SettingsCardMinHeight}"
                BorderThickness="0"
                Padding="{StaticResource SettingsExpanderHeaderPadding}"
                Background="{TemplateBinding Background}"
                CornerRadius="0"
                IsTabStop="True">

                <ToggleButton.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                      <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SettingsCardBackground" />
                        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SettingsCardBackgroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SettingsCardBackgroundPressed" />
                        <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SettingsCardBackgroundDisabled" />
                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="SettingsCardForeground" />
                        <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="SettingsCardForegroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="SettingsCardForegroundPressed" />
                        <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="SettingsCardForegroundDisabled" />
                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SettingsCardBorderBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SettingsCardBorderBrushPointerOver" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SettingsCardBorderBrushPressed" />
                        <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SettingsCardBorderBrushDisabled" />
                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SettingsCardBackground" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SettingsCardBackgroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SettingsCardBackgroundPressed" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SettingsCardBackgroundDisabled" />
                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SettingsCardForeground" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SettingsCardForegroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SettingsCardForegroundPressed" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="SettingsCardForegroundDisabled" />
                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SettingsCardBorderBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SettingsCardBorderBrushPointerOver" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SettingsCardBorderBrushPressed" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SettingsCardBorderBrushDisabled" />
                      </ResourceDictionary>
                      <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SettingsCardBackground" />
                        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SettingsCardBackgroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SettingsCardBackgroundPressed" />
                        <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SettingsCardBackgroundDisabled" />
                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="SettingsCardForeground" />
                        <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="SettingsCardForegroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="SettingsCardForegroundPressed" />
                        <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="SettingsCardForegroundDisabled" />
                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SettingsCardBorderBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SettingsCardBorderBrushPointerOver" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SettingsCardBorderBrushPressed" />
                        <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SettingsCardBorderBrushDisabled" />
                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SettingsCardBackground" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SettingsCardBackgroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SettingsCardBackgroundPressed" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SettingsCardBackgroundDisabled" />
                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SettingsCardForeground" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SettingsCardForegroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SettingsCardForegroundPressed" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="SettingsCardForegroundDisabled" />
                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SettingsCardBorderBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SettingsCardBorderBrushPointerOver" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SettingsCardBorderBrushPressed" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SettingsCardBorderBrushDisabled" />
                      </ResourceDictionary>
                      <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SettingsCardBackground" />
                        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SettingsCardBackgroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SettingsCardBackgroundPressed" />
                        <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SettingsCardBackgroundDisabled" />
                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="SettingsCardForeground" />
                        <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="SettingsCardForegroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="SettingsCardForegroundPressed" />
                        <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="SettingsCardForegroundDisabled" />
                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SettingsCardBorderBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SettingsCardBorderBrushPointerOver" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SettingsCardBorderBrushPressed" />
                        <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SettingsCardBorderBrushDisabled" />
                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SettingsCardBackground" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SettingsCardBackgroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SettingsCardBackgroundPressed" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SettingsCardBackgroundDisabled" />
                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SettingsCardForeground" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SettingsCardForegroundPointerOver" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SettingsCardForegroundPressed" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="SettingsCardForegroundDisabled" />
                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SettingsCardBorderBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SettingsCardBorderBrushPointerOver" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SettingsCardBorderBrushPressed" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SettingsCardBorderBrushDisabled" />
                      </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                  </ResourceDictionary>
                </ToggleButton.Resources>
              </ToggleButton>
              
              <FontIcon x:Name="ExpandCollapseChevron"
                Grid.Column="1"
                Margin="0,0,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource ExpanderChevronForeground}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="{StaticResource SettingsExpanderChevronFontSize}"
                Glyph="{StaticResource ExpanderChevronDownGlyph}"
                IsTextScaleFactorEnabled="False"
                IsHitTestVisible="False" />
            </Grid>

            <ScrollViewer x:Name="ScrollViewer"
              TabNavigation="{TemplateBinding TabNavigation}"
              HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
              IsHorizontalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsHorizontalScrollChainingEnabled}"
              VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
              IsVerticalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsVerticalScrollChainingEnabled}"
              IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
              IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
              ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}"
              IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
              BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
              AutomationProperties.AccessibilityView="Raw"
              Background="{TemplateBinding Background}"
              Visibility="Collapsed"
              x:Load="True">
              <ItemsPresenter Padding="{TemplateBinding Padding}" />
              <!--
              Header="{TemplateBinding Header}"
              HeaderTemplate="{TemplateBinding HeaderTemplate}"
              HeaderTransitions="{TemplateBinding HeaderTransitions}"
              Footer="{TemplateBinding Footer}"
              FooterTemplate="{TemplateBinding FooterTemplate}"
              FooterTransitions="{TemplateBinding FooterTransitions}"
              -->
            </ScrollViewer>

            <ContentPresenter x:Name="ExpanderFooter"
              Content="{TemplateBinding Footer}"
              ContentTemplate="{TemplateBinding FooterTemplate}"
              Background="{TemplateBinding Background}"
              BackgroundSizing="OuterBorderEdge"
              Padding="{StaticResource SettingsExpanderItemPadding}"
              BorderBrush="{ThemeResource SettingsCardBorderBrush}"
              BorderThickness="{StaticResource SettingsExpanderItemBorderThickness}"
              MinHeight="{StaticResource SettingsExpanderItemMinHeight}"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Center"
              Visibility="Collapsed"
              x:Load="True" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListViewItemCardStyle_MultipleSelectionMode" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{ThemeResource SettingsCardForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource SettingsExpanderItemBorderThickness}" />
    <Setter Property="Padding" Value="{StaticResource SettingsExpanderItemPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="{StaticResource SettingsExpanderItemMinHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Padding="{TemplateBinding Padding}"
            MinHeight="{TemplateBinding MinHeight}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <CheckBox
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              ContentTransitions="{TemplateBinding ContentTransitions}"
              Foreground="{TemplateBinding Foreground}"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
              IsTabStop="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
