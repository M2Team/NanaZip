<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NanaZip.Modern">

    <!-- Force Dark Mode for all themes -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Base colors for dark mode -->
            <Color x:Key="SystemBaseHighColor">#FFFFFFFF</Color>
            <Color x:Key="SystemBaseMediumHighColor">#FFE1E1E1</Color>
            <Color x:Key="SystemBaseMediumColor">#FFB4B4B4</Color>
            <Color x:Key="SystemBaseMediumLowColor">#FF8C8C8C</Color>
            <Color x:Key="SystemBaseLowColor">#FF6D6D6D</Color>
            <Color x:Key="SystemAltHighColor">#FF000000</Color>
            <Color x:Key="SystemAltMediumHighColor">#FF1F1F1F</Color>
            <Color x:Key="SystemAltMediumColor">#FF2D2D2D</Color>
            <Color x:Key="SystemAltMediumLowColor">#FF3E3E3E</Color>
            <Color x:Key="SystemAltLowColor">#FF4A4A4A</Color>

            <!-- Chrome colors -->
            <Color x:Key="SystemChromeHighColor">#FFFFFFFF</Color>
            <Color x:Key="SystemChromeMediumHighColor">#FFCCCCCC</Color>
            <Color x:Key="SystemChromeMediumColor">#FF999999</Color>
            <Color x:Key="SystemChromeMediumLowColor">#FF666666</Color>
            <Color x:Key="SystemChromeLowColor">#FF333333</Color>
            <Color x:Key="SystemChromeAltHighColor">#FF000000</Color>
            <Color x:Key="SystemChromeAltMediumHighColor">#FF1A1A1A</Color>
            <Color x:Key="SystemChromeAltMediumColor">#FF2D2D2D</Color>
            <Color x:Key="SystemChromeAltMediumLowColor">#FF3D3D3D</Color>
            <Color x:Key="SystemChromeAltLowColor">#FF4A4A4A</Color>

            <!-- Region colors -->
            <Color x:Key="SystemRegionColor">#FF1F1F1F</Color>
            <Color x:Key="SystemRegionColorAlt">#FF2D2D2D</Color>

            <!-- Accent colors -->
            <Color x:Key="SystemAccentColor">#FF0078D4</Color>
            <Color x:Key="SystemAccentColorLight1">#FF2E8CE6</Color>
            <Color x:Key="SystemAccentColorLight2">#FF5BA3E9</Color>
            <Color x:Key="SystemAccentColorLight3">#FF8BB8ED</Color>
            <Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF004578</Color>
            <Color x:Key="SystemAccentColorDark3">#FF003152</Color>

            <!-- Text colors -->
            <Color x:Key="TextFillColorPrimary">#FFFFFFFF</Color>
            <Color x:Key="TextFillColorSecondary">#FFCCCCCC</Color>
            <Color x:Key="TextFillColorTertiary">#FF999999</Color>
            <Color x:Key="TextFillColorDisabled">#FF666666</Color>

            <!-- Control colors -->
            <Color x:Key="ControlFillColorDefault">#FF2D2D2D</Color>
            <Color x:Key="ControlFillColorSecondary">#FF3E3E3E</Color>
            <Color x:Key="ControlFillColorTertiary">#FF4A4A4A</Color>
            <Color x:Key="ControlFillColorDisabled">#FF1F1F1F</Color>
            <Color x:Key="ControlStrokeColorDefault">#FF4A4A4A</Color>
            <Color x:Key="ControlStrokeColorSecondary">#FF3E3E3E</Color>

            <!-- Card colors -->
            <Color x:Key="CardStrokeColorDefault">#FF3E3E3E</Color>
            <Color x:Key="CardStrokeColorSecondary">#FF2D2D2D</Color>

            <!-- Selection colors -->
            <Color x:Key="TextControlSelectionHighlightColor">#FF0078D4</Color>

            <!-- Divider colors -->
            <Color x:Key="DividerStrokeColorDefault">#FF3E3E3E</Color>

            <!-- Background brushes -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseHighBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="#FF3E3E3E" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FF4A4A4A" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#FF3E3E3E" />
            <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#FF0078D4" />

            <!-- Foreground brushes -->
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#FFE1E1E1" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#FFB4B4B4" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#FF8C8C8C" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#FF6D6D6D" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeHighBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeMediumHighBrush" Color="#FFCCCCCC" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeMediumBrush" Color="#FF999999" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeMediumLowBrush" Color="#FF666666" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeLowBrush" Color="#FF333333" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FF0078D4" />

            <!-- Transparent brushes (for Transparent theme) -->
            <SolidColorBrush x:Key="TransparentBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TransparentChromeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TransparentCardBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>