<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NanaZip.Modern">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Matte/Acrylic Theme - Opaque with subtle texture feel -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Window background - Solid matte -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="WindowChromeBrush" Color="#FF1A1A1A" />

            <!-- Page backgrounds -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FF1F1F1F" />

            <!-- Control backgrounds - matte finish -->
            <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF252525" />
            <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="ControlBackgroundPressedBrush" Color="#FF353535" />

            <!-- Card backgrounds - matte elevated surfaces -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#FF282828" />

            <!-- Dialog backgrounds -->
            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="DialogChromeBrush" Color="#FF1A1A1A" />

            <!-- ListView/GridView backgrounds -->
            <SolidColorBrush x:Key="ListViewBackgroundBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundHoverBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedHoverBrush" Color="#FF006BCC" />

            <!-- TextBox backgrounds -->
            <SolidColorBrush x:Key="TextControlBackgroundBrush" Color="#FF252525" />
            <SolidColorBrush x:Key="TextControlBackgroundFocusedBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabledBrush" Color="#FF1A1A1A" />

            <!-- Button backgrounds -->
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF252525" />
            <SolidColorBrush x:Key="ButtonBackgroundHoverBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="ButtonBackgroundPressedBrush" Color="#FF353535" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabledBrush" Color="#FF1A1A1A" />

            <!-- Accent button -->
            <SolidColorBrush x:Key="AccentButtonBackgroundBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="AccentButtonBackgroundHoverBrush" Color="#FF006BCC" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressedBrush" Color="#FF0078D4" />

            <!-- Border brushes - subtle matte borders -->
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#FF4A4A4A" />
            <SolidColorBrush x:Key="ControlBorderFocusedBrush" Color="#FF0078D4" />

            <!-- ScrollBar -->
            <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="ScrollBarForegroundBrush" Color="#FF4A4A4A" />

            <!-- Separator -->
            <SolidColorBrush x:Key="SeparatorBrush" Color="#FF3A3A3A" />

            <!-- Tooltip -->
            <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF3A3A3A" />

            <!-- Flyout -->
            <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FF3A3A3A" />

            <!-- Menu -->
            <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="MenuBorderBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="MenuItemBackgroundHoverBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="MenuItemBackgroundPressedBrush" Color="#FF353535" />

            <!-- Acrylic accent brushes for special elements -->
            <SolidColorBrush x:Key="AcrylicAccentBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="AcrylicHighlightBrush" Color="#FF2D2D2D" />
            <SolidColorBrush x:Key="AcrylicElevation1Brush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="AcrylicElevation2Brush" Color="#FF252525" />
            <SolidColorBrush x:Key="AcrylicElevation3Brush" Color="#FF2D2D2D" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>