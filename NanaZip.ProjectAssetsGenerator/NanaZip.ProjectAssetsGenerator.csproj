<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MileDotNetHelpersEnableGitHelpers>true</MileDotNetHelpersEnableGitHelpers>
    <MileDotNetHelpersEnableImageAssetsHelpers>true</MileDotNetHelpersEnableImageAssetsHelpers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mile.DotNet.Helpers" Version="1.0.71" />
    <PackageReference Condition="'$(MileDotNetHelpersEnableImageAssetsHelpers)' == 'true'" Include="Magick.NET-Q8-AnyCPU" Version="*" />
  </ItemGroup>

</Project>
